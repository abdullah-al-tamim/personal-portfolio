{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "opportunity": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "masters",
            "phd"
          ]
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "official_url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "funding": {
          "type": "string",
          "enum": [
            "unknown",
            "full",
            "partial",
            "none"
          ]
        },
        "notes": {
          "default": "",
          "type": "string",
          "maxLength": 5000
        }
      },
      "required": [
        "title",
        "kind",
        "country",
        "official_url",
        "funding",
        "notes"
      ],
      "additionalProperties": false
    },
    "findings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "source_indexes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "verification": {
            "type": "string",
            "const": "unverified"
          }
        },
        "required": [
          "claim",
          "source_indexes",
          "verification"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "url",
          "title",
          "published_at",
          "retrieved_at",
          "excerpt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "external_id",
    "opportunity",
    "findings",
    "sources"
  ],
  "additionalProperties": false
}
